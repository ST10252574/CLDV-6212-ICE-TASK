# Copy this file to .env and change the values.  NEVER commit your real .env (it is in .gitignore).
# All values below are dummy placeholders.

# --- Local Postgres container (docker compose) ---
POSTGRES_DB=stocksense
POSTGRES_USER=stocksense
POSTGRES_PASSWORD=change-me-local-only

# --- API ---
# Signing key for login tokens. Use 32+ random characters, e.g.:  openssl rand -base64 48
JWT_KEY=replace-with-a-long-random-string-of-at-least-32-characters

# Origins allowed to call the API directly from a browser (comma separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# true = create a demo shop (demo@stocksense.app) with sample products on first start
SEED_DEMO_DATA=true

# --- Production only (set these in Render / GitHub Secrets, NOT here) ---
# ConnectionStrings__Default = postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require   (Neon)
# BACKEND_URL                = https://your-api-service.onrender.com                       (frontend service)
